# Security headers for static assets served directly by Cloudflare Pages.
# HTML pages get their headers (incl. nonce-based CSP from kit.csp.mode
# 'auto' in svelte.config.js) via src/hooks.server.ts. CSP MUST NOT be set
# here: a second enforced policy without the matching per-request nonce
# bricks hydration (all inline SvelteKit scripts blocked).
#
# NOTE: non-HTML assets (JS/CSS/images/PDFs) don't execute inline scripts,
# so they intentionally carry no CSP.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/favicon.*
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache
