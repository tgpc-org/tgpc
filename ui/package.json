{
  "name": "tgpc-ui",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-check --threshold error",
    "check:colors": "node scripts/check-colors.mjs",
    "lint": "eslint src",
    "test:unit": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:e2e": "playwright test",
    "test:e2e:update-baseline": "node ./e2e/update-baseline.mjs",
    "check:e2e": "tsc -p e2e/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
